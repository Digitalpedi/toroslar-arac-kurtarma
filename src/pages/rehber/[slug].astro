---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Figure from '~/components/Figure.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import { articleNode, faqNode } from '~/lib/schema';

export async function getStaticPaths() {
  const items = await getCollection('rehber');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
const d = item.data;
const path = `/rehber/${item.id}/`;

const related = (
  await Promise.all(d.related.map((slug) => getEntry('rehber', slug)))
).filter((e) => e !== undefined);

const breadcrumb = [
  { name: 'Rehber', href: '/rehber/' },
  { name: d.title, href: path },
];

const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

const toc = headings.filter((h) => h.depth === 2);

const schema = [
  articleNode({
    title: d.title,
    description: d.description,
    path,
    date: d.date,
    updated: d.updated,
    image: d.image ? `/media/${d.image}-1600.jpg` : undefined,
  }),
  faqNode(d.faq),
].filter((n) => n !== null);
---

<Base
  title={d.metaTitle}
  description={d.description}
  path={path}
  breadcrumb={breadcrumb}
  schema={schema}
>
  <article>
    <header class="post-head">
      <div class="container-site post-head__inner">
        <Breadcrumbs trail={breadcrumb} />

        <p class="post-head__cat kicker">{d.category}</p>

        <h1 class="post-head__title">{d.title}</h1>
        <p class="post-head__sum">{d.summary}</p>

        <div class="post-head__meta">
          <time class="meta" datetime={d.date.toISOString()}>{fmt.format(d.date)}</time>
          <span class="meta">·</span>
          <span class="meta">{d.readingTime} dakika okuma</span>
          {
            d.updated && (
              <>
                <span class="meta">·</span>
                <span class="meta">Güncellendi: {fmt.format(d.updated)}</span>
              </>
            )
          }
        </div>
      </div>
    </header>

    {
      d.image && (
        <div class="container-site">
          <div class="post-media" data-clip-reveal>
            <Figure
              name={d.image}
              alt={d.imageAlt ?? d.title}
              width={2400}
              height={1350}
              sizes="(min-width: 1200px) 1100px, 100vw"
              loading="eager"
              fetchpriority="high"
              cover
              imgClass="post-media__img"
            />
          </div>
        </div>
      )
    }

    <div class="section">
      <div class="container-site post-grid">
        <div class="prose post-body">
          <Content />
        </div>

        <aside class="post-side">
          {
            toc.length > 1 && (
              <nav class="toc" aria-label="İçindekiler">
                <p class="meta toc__title">İçindekiler</p>
                <ol>
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          <div class="post-call">
            <p class="kicker">{site.hoursLabel}</p>
            <p class="post-call__lead">Aracınız şu an yolda mı kaldı?</p>
            <a href={site.phone.href} class="btn btn--signal btn--block">
              <Icon name="phone" size={18} />
              {site.phone.display}
            </a>
            <a
              href={site.whatsapp.url}
              class="btn btn--outline btn--block"
              target="_blank"
              rel="noopener"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          </div>
        </aside>
      </div>
    </div>

    {
      d.faq.length > 0 && (
        <section class="section-sm band-stone-2">
          <div class="container-site faq-wrap">
            <Faq items={d.faq} kicker="Sık sorulanlar" title="Bu konuda sık sorulanlar" />
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="section-sm">
          <div class="container-site">
            <p class="kicker">İlgili yazılar</p>
            <ul class="related" data-reveal-group>
              {related.map((r) => (
                <li>
                  <a href={`/rehber/${r.id}/`} class="card card--hazard related__card">
                    <span class="meta">{r.data.category}</span>
                    <span class="related__title">{r.data.title}</span>
                    <span class="related__sum">{r.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>

  <CtaBand />
</Base>

<style>
  .post-head {
    padding-block: calc(var(--header-h) + clamp(2rem, 5vw, 3.5rem)) clamp(1.5rem, 3vw, 2.25rem);
    background-color: var(--color-stone-2);
    border-block-end: 1px solid var(--color-stone-3);
  }

  .post-head__inner {
    max-inline-size: 52rem;
  }

  .post-head__cat {
    margin-block-start: 1.5rem;
  }

  .post-head__title {
    margin-block-start: 0.9rem;
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    letter-spacing: var(--text-h1--letter-spacing);
  }

  .post-head__sum {
    margin-block-start: 1.15rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-600);
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.35rem;
  }

  .post-media {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-lg);
  }

  .post-media :global(.post-media__img) {
    block-size: 100%;
  }

  .post-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    }
    .post-side {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1.5rem);
    }
  }

  .post-body {
    max-inline-size: var(--container-prose);
  }

  .post-side {
    display: grid;
    gap: 1.25rem;
  }

  .toc {
    padding: 1.35rem;
    border: 1px solid var(--color-stone-3);
    border-radius: var(--radius-lg);
    background-color: var(--color-stone-0);
  }

  .toc__title {
    margin-block-end: 0.85rem;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
    display: grid;
    gap: 0.55rem;
  }

  .toc li {
    counter-increment: toc;
    display: flex;
    gap: 0.6rem;
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .toc li::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-amber-600);
    padding-block-start: 0.2em;
  }

  .toc a {
    color: var(--color-ink-600);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-ink-900);
    text-decoration: underline;
    text-decoration-color: var(--color-amber-500);
  }

  .post-call {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-ink-900);
  }

  .post-call .kicker {
    color: var(--color-amber-400);
  }

  .post-call__lead {
    color: var(--color-ink-fg);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    margin-block-end: 0.3rem;
  }

  .faq-wrap {
    max-inline-size: 60rem;
  }

  .related {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .related__card {
    display: grid;
    gap: 0.45rem;
    padding: 1.35rem;
    text-decoration: none;
    overflow: hidden;
  }

  .related__title {
    font-family: var(--font-display);
    font-size: 1.075rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink-900);
  }

  .related__sum {
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--color-ink-600);
  }

  @media (min-width: 700px) {
    .post-media {
      aspect-ratio: 16 / 9;
    }
  }
</style>
