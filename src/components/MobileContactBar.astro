---
import Icon from './Icon.astro';
import { site } from '~/data/site';
---

<div class="contact-bar" data-contact-bar>
  <a href={site.phone.href} class="contact-bar__btn contact-bar__btn--call">
    <Icon name="phone" size={19} />
    <span>Hemen Ara</span>
  </a>
  <a
    href={site.whatsapp.url}
    class="contact-bar__btn contact-bar__btn--wa"
    target="_blank"
    rel="noopener"
  >
    <Icon name="whatsapp" size={19} />
    <span>WhatsApp</span>
  </a>
</div>

<style>
  .contact-bar {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: var(--z-bar);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background-color: var(--color-ink-900);
    padding-block-end: env(safe-area-inset-bottom);
  }

  /* Üst kenarda ikaz şeridi — marka imzası */
  .contact-bar::before {
    content: '';
    position: absolute;
    inset-block-end: 100%;
    inset-inline: 0;
    block-size: 3px;
    background-image: var(--hazard-fine);
  }

  .contact-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-block-size: 3.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    font-stretch: 92%;
    text-decoration: none;
    transition: filter var(--duration-fast) linear;
  }

  .contact-bar__btn:active {
    filter: brightness(0.92);
  }

  .contact-bar__btn--call {
    background-color: var(--color-amber-500);
    color: var(--color-ink-900);
  }

  .contact-bar__btn--wa {
    background-color: var(--color-ink-900);
    color: var(--color-ink-fg);
  }

  @media (min-width: 981px) {
    .contact-bar {
      display: none;
    }
  }
</style>

<script>
  /* Alt bar yüksekliğini --bar-h'ye yaz — footer ve sabit öğeler altında kalmasın */
  function syncBarHeight() {
    const bar = document.querySelector<HTMLElement>('[data-contact-bar]');
    const set = () => {
      const visible = bar && getComputedStyle(bar).display !== 'none';
      document.documentElement.style.setProperty(
        '--bar-h',
        visible ? `${bar!.offsetHeight}px` : '0rem',
      );
    };
    set();
    window.addEventListener('resize', set, { passive: true });
  }

  syncBarHeight();
  document.addEventListener('astro:page-load', syncBarHeight);
</script>
