---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Figure from '~/components/Figure.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { site, districts } from '~/data/site';
import { serviceNode, faqNode } from '~/lib/schema';

export async function getStaticPaths() {
  const items = await getCollection('bolgeler');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const path = `/bolgeler/${item.id}/`;

const others = districts.filter((x) => x.slug !== item.id);

const services = (await getCollection('hizmetler')).sort((a, b) => a.data.order - b.data.order);

const breadcrumb = [
  { name: 'Bölgeler', href: '/bolgeler/' },
  { name: d.title, href: path },
];

const schema = [
  serviceNode({
    name: `${d.district} oto çekici ve araç kurtarma`,
    description: d.description,
    path,
    areaName: d.district,
  }),
  faqNode(d.faq),
].filter((n) => n !== null);
---

<Base
  title={d.metaTitle}
  description={d.description}
  path={path}
  breadcrumb={breadcrumb}
  schema={schema}
  headerOnDark
>
  <PageHero
    kicker={d.kicker}
    title={d.title}
    lead={d.lead}
    breadcrumb={breadcrumb}
    watermark={site.plateCode}
  />

  <section class="strip">
    <div class="container-site strip__inner">
      <div class="strip__block" data-reveal="up">
        <p class="meta">Mahalleler</p>
        <ul class="chips">
          {d.neighborhoods.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      {
        d.routes.length > 0 && (
          <div class="strip__block" data-reveal="up" data-reveal-delay="0.1">
            <p class="meta">Ana güzergâhlar</p>
            <ul class="chips chips--route">
              {d.routes.map((r) => (
                <li>
                  <Icon name="route" size={14} />
                  {r}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    d.image && (
      <section class="area-media">
        <div class="container-site">
          <div class="area-media__frame" data-clip-reveal>
            <Figure
              name={d.image}
              alt={d.imageAlt ?? `${d.district} — ${site.name}`}
              width={2400}
              height={1350}
              sizes="(min-width: 1200px) 1100px, 100vw"
              cover
              imgClass="area-media__img"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-site area-grid">
      <div class="prose" data-reveal="up">
        <Content />
      </div>

      <aside class="area-side">
        {
          d.cases.length > 0 && (
            <div class="side-box" data-reveal="up" data-reveal-delay="0.1">
              <h2 class="side-box__title">{d.district}’da sık gelen çağrılar</h2>
              <ul class="cases">
                {d.cases.map((c) => (
                  <li>
                    <h3 class="cases__title">{c.title}</h3>
                    <p class="cases__text">{c.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="side-box side-box--call" data-reveal="up" data-reveal-delay="0.18">
          <p class="kicker">{site.hoursLabel}</p>
          <p class="side-box__lead">{d.district}’dan arıyorsanız konum göndermeniz yeterli.</p>
          <a href={site.phone.href} class="btn btn--signal btn--block">
            <Icon name="phone" size={18} />
            {site.phone.display}
          </a>
          <a
            href={site.whatsapp.url}
            class="btn btn--outline btn--block"
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-sm band-stone-2">
    <div class="container-site">
      <p class="kicker">{d.district}’da verdiğimiz hizmetler</p>
      <ul class="svc-links" data-reveal-group>
        {
          services.map((s) => (
            <li>
              <a href={`/hizmetler/${s.id}/`} class="svc-link">
                <Icon name={s.data.icon} size={19} />
                <span>{s.data.title}</span>
                <Icon name="arrow-up-right" size={15} class="svc-link__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    d.faq.length > 0 && (
      <section class="section">
        <div class="container-site faq-wrap">
          <Faq items={d.faq} kicker="Sık sorulanlar" title={`${d.district} çekici hakkında sorular`} />
        </div>
      </section>
    )
  }

  <section class="section-sm">
    <div class="container-site">
      <p class="kicker">Diğer bölgeler</p>
      <ul class="others" data-reveal-group>
        {
          others.map((o) => (
            <li>
              <a href={`/bolgeler/${o.slug}/`} class="card card--hazard others__card">
                <Icon name="map-pin" size={19} />
                <span class="others__title">{o.title}</span>
                <span class="others__short">{o.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .strip {
    background-color: var(--color-stone-2);
    border-block-end: 1px solid var(--color-stone-3);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  .strip__inner {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .strip__inner {
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-stone-0);
    border: 1px solid var(--color-stone-3);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    color: var(--color-ink-700);
  }

  .chips--route li :global(svg) {
    color: var(--color-amber-600);
  }

  .area-media {
    padding-block-start: clamp(1.75rem, 4vw, 3rem);
  }

  .area-media__frame {
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-lg);
  }

  .area-media__frame :global(.area-media__img) {
    block-size: 100%;
  }

  .area-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .area-grid {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 24rem);
    }
    .area-side {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1.5rem);
    }
  }

  .area-side {
    display: grid;
    gap: 1rem;
  }

  .side-box {
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    background-color: var(--color-stone-0);
    border: 1px solid var(--color-stone-3);
    border-radius: var(--radius-lg);
  }

  .side-box--call {
    background-color: var(--color-ink-900);
    border-color: var(--color-ink-900);
    display: grid;
    gap: 0.65rem;
  }

  .side-box--call .kicker {
    color: var(--color-amber-400);
  }

  .side-box--call .side-box__lead {
    color: var(--color-ink-fg-muted);
    font-size: var(--text-small);
  }

  .side-box__title {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    margin-block-end: 1.15rem;
  }

  .cases {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.15rem;
  }

  .cases li {
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--color-amber-500);
  }

  .cases__title {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .cases__text {
    margin-block-start: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-600);
  }

  .svc-links {
    display: grid;
    gap: 0.6rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .svc-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .svc-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .svc-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.15rem;
    min-block-size: 3.25rem;
    background-color: var(--color-stone-0);
    border: 1px solid var(--color-stone-3);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink-900);
    transition:
      border-color var(--duration-base) var(--ease-out-quart),
      background-color var(--duration-base) var(--ease-out-quart);
  }

  .svc-link :global(svg) {
    color: var(--color-amber-600);
    flex: none;
  }

  .svc-link__arrow {
    margin-inline-start: auto;
    color: var(--color-ink-500);
  }

  .svc-link:hover {
    border-color: var(--color-ink-900);
  }

  .faq-wrap {
    max-inline-size: 60rem;
  }

  .others {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .others {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .others__card {
    display: grid;
    gap: 0.5rem;
    padding: 1.35rem;
    text-decoration: none;
    overflow: hidden;
  }

  .others__card :global(svg) {
    color: var(--color-amber-600);
  }

  .others__title {
    font-family: var(--font-display);
    font-size: 1.075rem;
    font-weight: 600;
    color: var(--color-ink-900);
  }

  .others__short {
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--color-ink-600);
  }

  @media (min-width: 700px) {
    .area-media__frame {
      aspect-ratio: 16 / 9;
    }
  }
</style>
